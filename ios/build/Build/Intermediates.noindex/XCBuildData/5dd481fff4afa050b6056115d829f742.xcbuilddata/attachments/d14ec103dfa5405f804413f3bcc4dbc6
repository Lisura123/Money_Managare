#!/bin/sh
/bin/sh "$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh" embed_and_thin
# Strip iCloud xattrs AFTER embed_and_thin copies frameworks
if [ -d "${BUILT_PRODUCTS_DIR}" ]; then xattr -rc "${BUILT_PRODUCTS_DIR}" 2>/dev/null || true; fi
if [ -d "${BUILD_DIR}" ]; then xattr -rc "${BUILD_DIR}" 2>/dev/null || true; fi
